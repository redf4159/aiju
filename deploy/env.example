# 复制为 web/.env 或写入 systemd Environment=（勿提交真实密钥）
# ---- Web 登录 ----
WEB_USER=changeme
WEB_PASSWORD=changeme
BINGJING_FILE_TOKEN_SECRET=

# ---- 路径 ----
BINGJING_DATA=/opt/ai-forge/bingjing/web/data
COMFYUI_ROOT=/home/linux/ComfyUI
COMFYUI_URL=http://127.0.0.1:18000
PUBLIC_COMFYUI_URL=http://127.0.0.1:8000

# ---- 分镜 / 成片 ----
STORYBOARD_BACKEND=image_api
STORYBOARD_IMAGE_API_BASE=https://your-gateway/v1
STORYBOARD_IMAGE_API_KEY=
STORYBOARD_IMAGE_MODEL=gpt-image-2.5-flare
STORYBOARD_IMAGE_TIMEOUT=180
STORYBOARD_STALE_SEC=420
EPISODE_VIDEO_SEGMENTED=1
DRAMA10_WEB_AUDIO_ONLY=0
DRAMA10_HUM_FALLBACK_REMUX=0

# ---- 可选：从制作台读 Comfy 日志 ETA（GPU 机 SSH）----
# COMFY_LOG_SSH=1
# COMFY_LOG_SSH_HOST=
# COMFY_LOG_SSH_PORT=22
# COMFY_LOG_SSH_USER=linux
# COMFY_LOG_SSH_PASSWORD=
# COMFY_LOG_PATH=/home/linux/ComfyUI/comfy_run.log
