[Unit]

Description=ComfyUI (Bingjing / Drama10 / MiniMax H3)

After=network.target



[Service]

Type=simple

WorkingDirectory=/home/linux/ComfyUI

Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/linux/bingjing/web/.env

Environment=VIDEO_CANVAS_SHORT_EDGE=480

Environment=EPISODE_VIDEO_SEGMENTED=1

Environment=DRAMA10_USE_XFADE=0

Environment=DRAMA10_BURN_SUBS=0

Environment=DRAMA10_MOUTH_LAG=1.0

Environment=DRAMA10_DRIFT_PER_SHOT=0.15

ExecStart=/home/linux/comfyui-venv/bin/python main.py --listen 0.0.0.0 --port 8000

Restart=always

RestartSec=20

StandardOutput=append:/home/linux/ComfyUI/comfy_run.log

StandardError=append:/home/linux/ComfyUI/comfy_run.log



[Install]

WantedBy=default.target



